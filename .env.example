# Better Auth Infrastructure & Dash Configuration
# API key obtained from Better Auth dashboard (https://better-auth.com or Infra console)
BETTER_AUTH_API_KEY=ba_6xnsxm5u45a5hkn09hcpmt4zl6es3xft
BETTER_AUTH_SECRET=your-random-better-auth-secret-here

# Application Deployment URL
# In local development: http://localhost:3000
# In production: The URL where your app is deployed (e.g., https://myapp.com)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection (PostgreSQL / Supabase connection pooling string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ratefactor

# Supabase Public & Service Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Sentry Monitoring & Error Tracking (Next.js SDK)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ORG=ratefactor
SENTRY_PROJECT=ratefactor-web
SENTRY_AUTH_TOKEN=your-sentry-auth-token-for-sourcemaps

# PostHog Telemetry, Uptime & Downtime Monitoring
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=phc_your_posthog_project_api_key_here

# Resend Transactional Email & OTP Verification (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=RateFactor <onboarding@resend.dev>

